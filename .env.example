# Optional. Free key: https://aistudio.google.com/apikey
# Without a key the system runs in extractive mode (no LLM needed).
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Seconds between LLM calls (free tier ~10 req/min). Set 0 on a paid key.
LLM_MIN_INTERVAL=6
# EMBEDDER=hashing  # offline/test embedder
